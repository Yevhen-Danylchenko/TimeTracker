@model IEnumerable<TimeTracker.Models.TimeEntry>

@{
    ViewData["Title"] = "Today's Entries";
}

<h2>Today's Entries</h2>

<a class="btn btn-primary mb-3" asp-action="Create">Add New Entry</a>

@if (!Model.Any())
{
    <div class="alert alert-info">No entries for today.</div>
}
else
{
    @foreach (var entry in Model)
    {
        @Html.Partial("_TimeEntryPartial", entry)
    }
}

